{
    "name": "intelligent-portfolio-backend",
    "version": "1.0.0",
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "type": "module",
    "scripts": {
        "start": "node dist/migrate.js up && node dist/index.js",
        "build": "tsc && cp -r migrations dist/",
        "dev": "tsx watch index.ts",
        "seed": "tsx scripts/seed.ts",
        "migrate": "tsx migrate.ts",
        "db:export": "tsx scripts/export_data.ts",
        "test": "vitest run"
    },
    "dependencies": {
        "@google/genai": "^1.44.0",
        "@neondatabase/serverless": "^1.0.2",
        "axios": "^1.13.6",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^16.6.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.3.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.20.0",
        "stripe": "^20.4.1",
        "yahoo-finance2": "^3.13.2",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-rate-limit": "^5.1.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.3.3",
        "@types/pg": "^8.18.0",
        "@types/supertest": "^7.2.0",
        "nodemon": "^3.1.0",
        "supertest": "^7.2.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.0"
    }
}