# O aplicativo funciona sem criar este arquivo.
# Copie para .env apenas se quiser personalizar.

# --- MODO LOCAL ---
NODE_ENV=development
PORT=3001
LOCAL_MODE=true
DATABASE_PATH=data/intelligent-portfolio.db
FRONTEND_URL=http://localhost:5173

# Troque este segredo se outras pessoas acessarem o servidor na sua rede.
JWT_SECRET=intelligent-portfolio-local-secret-change-me-2026

# --- RECURSOS OPCIONAIS ---
# Habilita o consultor de IA.
GEMINI_API_KEY=

# Chave opcional para dados de mercado B3.
BRAPI_API_KEY=

# Pagamentos ficam desativados no modo local.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ALERT_WEBHOOK_URL=
LOG_LEVEL=info
