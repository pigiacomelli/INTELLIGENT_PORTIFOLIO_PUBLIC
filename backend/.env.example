# --- CORE ---
NODE_ENV=development
PORT=3001
# URL do banco Neon (PostgreSQL) com ?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Segredo para o JWT (mínimo 32 caracteres)
JWT_SECRET=mudar_para_um_segredo_longo_e_aleatorio_32_chars
# URL do frontend para CORS e Stripe redirects
FRONTEND_URL=http://localhost:5173

# --- DATA PROVIDERS ---
# Chave da API do Google Gemini
GEMINI_API_KEY=AIza...
# Chave da BRAPI (opcional no momento, mas recomendada)
BRAPI_API_KEY=vossa_chave_brapi

# --- PAYMENTS (STRIPE) ---
# Chave secreta do Stripe (sk_test_... ou sk_live_...)
STRIPE_SECRET_KEY=sk_test_...
# Secret de assinatura do Webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- OBSERVABILITY ---
# URL do Webhook para alertas (Discord/Slack/Teams)
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Nível de log: info, warn, error, fatal
LOG_LEVEL=info
